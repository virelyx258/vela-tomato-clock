  width: 300px;
  height: 97px;
  color: #ffffff;
  font-size: 64px;
  font-weight: 500;
  line-height: 84.86px;
  text-align: center;
}

.focus-label {
  position: absolute;
  left: 66px;
  top: 287px;
  width: 300px;
  height: 38px;
  color: rgba(255, 255, 255, 0.6);
  font-size: 32px;
  font-weight: 500;
  line-height: 42.43px;
  text-align: center;
}

.stop-button,
.pause-button {
  position: absolute;
  top: 435px;
